---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { company } from '../data/company';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
const pageTitle = title ? `${title} | ${company.name}` : `${company.name} | ${company.tagline}`;
const pageDescription = description ?? company.description;
const ogImageUrl = ogImage ?? '/logo.png';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: company.name,
  alternateName: company.nameEn,
  url: Astro.site?.toString(),
  logo: new URL('/logo.png', Astro.site).toString(),
  telephone: company.phone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '見福2-20-19',
    addressLocality: '本庄市',
    addressRegion: '埼玉県',
    postalCode: '367-0044',
    addressCountry: 'JP',
  },
  areaServed: company.area,
  founder: company.ceo,
  numberOfEmployees: 10,
};
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&family=Noto+Sans+JP:wght@400;500;700;900&display=swap" rel="stylesheet" />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL(ogImageUrl, Astro.site)} />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:locale" content="ja_JP" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />

    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} is:inline />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      const items = document.querySelectorAll('.reveal');
      // すぐ画面に入っているものは即時表示
      const inView = (el: Element) => {
        const r = el.getBoundingClientRect();
        return r.top < window.innerHeight && r.bottom > 0;
      };
      items.forEach((el) => { if (inView(el)) el.classList.add('is-visible'); });

      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('is-visible');
            io.unobserve(e.target);
          }
        });
      }, { threshold: 0, rootMargin: '0px 0px 100px 0px' });
      items.forEach((el) => io.observe(el));

      // フォールバック: 1.5秒後に未発動を全部 visible 化
      setTimeout(() => {
        document.querySelectorAll('.reveal:not(.is-visible)').forEach((el) => {
          el.classList.add('is-visible');
        });
      }, 1500);
    </script>
  </body>
</html>
