---
import { company } from '../data/company';
---

<footer class="bg-[#f5f5f7] border-t border-[#d2d2d7]">
  <div class="mx-auto max-w-[1280px] px-5 lg:px-8 py-16 lg:py-20">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 lg:gap-16">
      <div>
        <div class="mb-5">
          <img src="/header-logo.png" alt={company.name} class="h-10 w-auto" />
        </div>
        <p class="text-sm leading-relaxed text-[#1d1d1f] max-w-xs">
          {company.description}
        </p>
      </div>

      <div>
        <h3 class="text-[11px] font-semibold text-[#1d1d1f] tracking-[0.15em] uppercase mb-4">
          会社情報
        </h3>
        <dl class="space-y-2.5 text-sm text-[#1d1d1f]">
          <div>
            <dt class="text-[11px] text-[#1d1d1f] mb-0.5">所在地</dt>
            <dd>{company.address}</dd>
          </div>
          <div>
            <dt class="text-[11px] text-[#1d1d1f] mb-0.5">電話</dt>
            <dd><a href={`tel:${company.phone}`} class="hover:text-[#0066cc]">{company.phone}</a></dd>
          </div>
          <div>
            <dt class="text-[11px] text-[#1d1d1f] mb-0.5">営業時間</dt>
            <dd>{company.hours}</dd>
          </div>
        </dl>
      </div>

      <div>
        <h3 class="text-[11px] font-semibold text-[#1d1d1f] tracking-[0.15em] uppercase mb-4">
          サイトマップ
        </h3>
        <ul class="grid grid-cols-2 gap-y-2.5 text-sm text-[#1d1d1f]">
          <li><a href="/" class="hover:text-[#0066cc] transition">ホーム</a></li>
          <li><a href="/services" class="hover:text-[#0066cc] transition">事業内容</a></li>
          <li><a href="/works" class="hover:text-[#0066cc] transition">施工事例</a></li>
          <li><a href="/company" class="hover:text-[#0066cc] transition">会社概要</a></li>
          <li><a href="/recruit" class="hover:text-[#0066cc] transition">採用情報</a></li>
          <li><a href="/contact" class="hover:text-[#0066cc] transition">お問い合わせ</a></li>
        </ul>

        <div class="mt-6">
          <a href={company.instagram} target="_blank" rel="noopener" aria-label="Instagram"
             class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-[#1d1d1f] hover:bg-black text-white transition">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zM12 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zm0 10.162a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div class="mt-14 pt-6 border-t border-[#d2d2d7] text-[11px] text-[#1d1d1f] flex flex-col sm:flex-row justify-between gap-2">
      <p>&copy; {new Date().getFullYear()} {company.name}. All rights reserved.</p>
      <p>{company.license}</p>
    </div>
  </div>
</footer>
