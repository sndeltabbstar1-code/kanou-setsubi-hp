---
interface Props {
  icon: string;
  class?: string;
}
const { icon, class: className = 'w-10 h-10' } = Astro.props;
---

{icon === 'water' && (
  <svg class={className} fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
    <path stroke-linecap="round" stroke-linejoin="round" d="M12 3c-3 4.5-6 7.5-6 11a6 6 0 1012 0c0-3.5-3-6.5-6-11z"/>
  </svg>
)}
{icon === 'air' && (
  <svg class={className} fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
    <path stroke-linecap="round" stroke-linejoin="round" d="M3 8h12a3 3 0 100-6M3 12h18M3 16h15a3 3 0 110 6"/>
  </svg>
)}
{icon === 'gas' && (
  <svg class={className} fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
    <path stroke-linecap="round" stroke-linejoin="round" d="M12 2c1.5 3 5 5 5 9a5 5 0 11-10 0c0-1.5.5-3 1.5-4 .5 1 1.5 1.5 2.5 1.5C9 6 10.5 4 12 2z"/>
  </svg>
)}
{icon === 'fire' && (
  <svg class={className} fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
    <path stroke-linecap="round" stroke-linejoin="round" d="M15.36 5.21A8 8 0 0112 21a8 8 0 01-3-15.45c0 2 1 3 2 3 0-2 1-4.5 4.36-3.34z"/>
  </svg>
)}
{icon === 'sanitary' && (
  <svg class={className} fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
    <path stroke-linecap="round" stroke-linejoin="round" d="M5 12V6a2 2 0 012-2h10a2 2 0 012 2v6m-14 0h14m-14 0v6a4 4 0 004 4h6a4 4 0 004-4v-6M9 16h6"/>
  </svg>
)}
